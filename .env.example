# 9Router / DXRouter environment contract
# This file reflects actual runtime usage in the current codebase.
# M0 changed several defaults in the secure direction — see "M0 security" below.

# ─── Required ────────────────────────────────────────────────────────────────
# Signs the dashboard session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# The single data root: database, logs, backups, MITM state, tailscale state.
# There is no second location — nothing writes to ~/.9router when this is set.
# Default when unset: %APPDATA%/9router (Windows), ~/Library/…/9router (macOS),
# ~/.9router (Linux). `DATA_DIR` is the deprecated spelling and still works.
DXR_DATA_DIR=/var/lib/9router

# ─── M0 security ─────────────────────────────────────────────────────────────
# Authentication is ON by default, including for loopback callers, and there is
# no default password. On first run the server generates a random credential,
# prints it once, and writes it to <data root>/initial-credential.txt (mode
# 0600); that file is deleted on first successful login. Set INITIAL_PASSWORD
# only to provision a known credential yourself — leaving it unset is the
# recommended path.
# INITIAL_PASSWORD=

# Master key for the AES-256-GCM credential envelope (`dxr1:` prefix) that
# protects stored OAuth tokens and API keys. 64 hex chars or base64 for 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Resolution order: DXR_MASTER_KEY → OS keychain (DPAPI / Keychain / libsecret).
# If neither is available the server REFUSES TO START rather than storing
# provider credentials in the clear.
# DXR_MASTER_KEY=

# Where the key lives when DXR_MASTER_KEY is unset.
#   keychain  require the OS keychain, refuse to start if it is unavailable
#   file      keep the key in <data root>/master.key (mode 0600)
# `file` is the escape hatch for headless hosts with no keychain. It is weaker —
# the key then sits next to the data it protects — so it must be chosen
# explicitly and is warned about on every boot.
# DXR_KEY_STORE=file

# Binding to anything other than loopback requires an explicit opt-in AND
# authentication left enabled. Wildcard binds (0.0.0.0, ::) are refused.
# DXR_ALLOW_NETWORK=1

# Request/response bodies in diagnostics. Two independent switches, both off by
# default: observability records request *shape* only, and the bodies themselves
# are a second decision. Authorization headers, API keys and cookies are redacted
# unconditionally either way — that is not configurable.
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=false
# DXR_PERSIST_REQUEST_BODIES=0

# ─── Milestone flags (M1+) ───────────────────────────────────────────────────
# The continuity engine ships OFF and accountFallback remains authoritative.
# Setting a flag for an unimplemented milestone is reported at boot and ignored,
# so nobody concludes a feature is live because a variable is set.
# DXR_ENGINE=off              # off | shadow | on
# DXR_ENGINE_AUTHORITY=0      # clamped to 0 while DXR_ENGINE=off
# DXR_SHADOW=0                # clamped to 0 while DXR_ENGINE=off
#
# Session observation (M1) is the one switch that is ON by default and independent
# of DXR_ENGINE: it writes prefix hashes, identity grades and token counts to
# <data root>/db/continuity.sqlite and never influences routing. Request bodies are
# never stored. Set this to 0 to roll M1 back to silence.
# DXR_SESSIONS=1              # M1 — observation only, on by default
# DXR_SESSION_INFERENCE=0     # M2 — not implemented (engine acting on identity)
# DXR_COMPAT_PROBES=0         # M2 — not implemented
# DXR_CACHE_ECONOMICS=0       # M2 — not implemented
# DXR_SESSION_REBASE=0        # M4 — not implemented
# DXR_DRIFT_SENTINEL=0        # M4 — not implemented
# DXR_FLAG_BANNER=1           # print the resolved flag state at boot

# ─── Recommended runtime variables ───────────────────────────────────────────
PORT=20128
NODE_ENV=production

# ─── Recommended security and ops variables ──────────────────────────────────
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
AUTH_COOKIE_SECURE=false
# Whether the /v1 API requires a key is a stored setting (`requireApiKey`,
# default true) edited from the dashboard, not an environment variable.

# ─── Cloud sync variables ────────────────────────────────────────────────────
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# ─── Optional outbound proxy variables for upstream provider calls ───────────
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# ─── Test seams (never set in production) ────────────────────────────────────
# DXR_BOOTSTRAP_NO_EXIT=1     # throw instead of process.exit(1) on refusal

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
